CHATBOT_API_URL=http://localhost:8001
CHATBOT_TIMEOUT_SECONDS=45
# Set to "google" in Cloud Run when calling a private chatbot service.
CHATBOT_AUTH=

# Comma-separated CORS origins; defaults to http://localhost:5173-5177 when unset.
ALLOWED_ORIGINS=

# Per-IP /chat rate limit (requests per minute; 0 disables).
RATE_LIMIT_PER_MINUTE=10

# Serve Swagger UI (/docs), ReDoc (/redoc) and /openapi.json. Only turn on for local development.
ENABLE_API_DOCS=false

DATABASE_URL=postgresql+psycopg://querio:querio@localhost:5432/querio
CONFIDENCE_THRESHOLD=0.6
