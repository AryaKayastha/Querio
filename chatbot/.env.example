GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2

# Optional fallback chat provider (routing + answers only; embeddings and OCR stay on Gemini).
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Order to try chat providers in; providers without a key are skipped.
CHAT_PROVIDERS=gemini,groq
