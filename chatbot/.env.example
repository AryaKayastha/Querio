GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2

# Optional fallback chat provider (routing + answers only; embeddings and OCR stay on Gemini).
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b

# Order to try chat providers in; providers without a key are skipped.
CHAT_PROVIDERS=gemini,groq

# Serve Swagger UI (/docs), ReDoc (/redoc) and /openapi.json. Only turn on for local development.
ENABLE_API_DOCS=false

# Seconds before an unanswered question gets a 503 "try again shortly". Keep below the backend's
# CHATBOT_TIMEOUT_SECONDS (45) so students see that message rather than a backend timeout.
CHAT_DEADLINE_SECONDS=40
# Questions answered at once; more wait their turn (within the deadline) instead of all hitting the
# model quotas together.
MAX_CONCURRENT_CHATS=4
